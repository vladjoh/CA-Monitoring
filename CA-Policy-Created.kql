AuditLogs
| where TimeGenerated >= ago(5m)
| where Category == "Policy"
| where OperationName == "Add conditional access policy"
| extend
    ChangeType   = "🟢 CREATE",
    PolicyName   = tostring(TargetResources[0].displayName),
    PolicyId     = tostring(TargetResources[0].id),
    Actor        = tostring(InitiatedBy.user.userPrincipalName),
    ActorIP      = tostring(InitiatedBy.user.ipAddress),
    ActorApp     = tostring(InitiatedBy.app.displayName),
    Result       = tostring(ResultType),
    NewConfig    = tostring(TargetResources[0].modifiedProperties)
| extend
    RiskFlag     = iff(Actor == "", "⚠️ App/Service Principal – No user UPN", "✅ User Account")
| project
    TimeGenerated,
    ChangeType,
    PolicyName,
    PolicyId,
    Actor,
    RiskFlag,
    ActorIP,
    ActorApp,
    Result,
    NewConfig,
    CorrelationId
| order by TimeGenerated desc